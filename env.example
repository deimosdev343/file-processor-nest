# --- NestJS API ---
# Set to 8000 to match the frontend's default API_URL.
PORT=8000

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dataset_analyzer

# --- Auth ---
JWT_SECRET=change-me

# --- OpenAI ---
# Required at boot; the app throws without it.
OPEN_AI_KEY=

# --- Dataset analysis (all optional; defaults shown) ---
# DATASET_ANALYSIS_MODEL=gpt-5.6-luna
# DATASET_MAX_ROWS_PROFILED=200000
# DATASET_SAMPLE_ROWS=5
# DATASET_TOP_K=8
# DATASET_MAX_UPLOAD_BYTES=52428800

# --- Python metric service ---
# PYTHON_ANALYSIS_URL=http://localhost:8100
# PYTHON_ANALYSIS_TIMEOUT_MS=30000

# --- Queue (not wired yet) ---
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_PREFIX=dsa
# QUEUE_STAGING_DIR=/tmp/dataset-analysis
# QUEUE_CONCURRENCY=2
# QUEUE_ATTEMPTS=3
# QUEUE_BACKOFF_MS=5000
# QUEUE_JOB_TIMEOUT_MS=180000
# QUEUE_RESULT_TTL_HOURS=24
